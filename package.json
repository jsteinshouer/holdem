{
  "name": "friendly-holdem",
  "version": "0.0.0",
  "private": true,
  "description": "Private-link, play-money Texas Hold 'em for friends.",
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @friendly-holdem/client --filter @friendly-holdem/server dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @friendly-holdem/server start",
    "typecheck": "tsc -b",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r exec vitest run --passWithNoTests --coverage --coverage.provider=v8 --coverage.reporter=text --coverage.include='src/**'",
    "test:e2e": "playwright test",
    "test:e2e:prod": "pnpm build && playwright test --config=playwright.production.config.ts",
    "test:e2e:smoke": "playwright test --config=playwright.smoke.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "3.2.4",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
