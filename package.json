{
  "name": "friendly-holdem",
  "version": "0.0.0",
  "private": true,
  "description": "Private-link, play-money Texas Hold 'em for friends.",
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @friendly-holdem/client --filter @friendly-holdem/server dev",
    "build": "pnpm -r build",
    "typecheck": "tsc -b",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
